!assets/long-read/samplesheets/template/

# keep everything else in those dirs ignored, except the specific files
assets/short-read/samplesheets/tgs/*
!assets/short-read/samplesheets/tgs/TGS_EMEL_sequenced_1.csv

!assets/short-read/samplesheets/template/samplesheet_merged.csv
!assets/short-read/samplesheets/template/samplesheet_paired.csv
!assets/long-read/samplesheets/template/samplesheet.csv