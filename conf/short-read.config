/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Meta-short Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

params {

    // Input and output options
    input                      = "/scicomp/home-pure/rtq0/EMEL/projects/align-ID/assets/short-read/samplesheets/tgs/TGS_EMEL_sequenced_1.csv"
    outdir                     = 'results/short-read/tgs/EMEL_sequenced_1'

    workflow = "short-read"

    //enable memory saver mode for local runtime environments
    memory_saver = false

    //define your workflow here by skipping or not skipping certain processes
    skip_subsample                 = true
    skip_merging                   = true
    skip_manual_trimming           = true
    skip_trimming                  = false
    skip_blast_unmapped            = false

    
    // filters for classified reads that align with reference genomes corresponding to tax IDs specified in the my_tax_ids file
    skip_filter_alignment_by_id       = false

    // include all child nodes of your designated tax IDs
    include_children = true

    // subsampling parameters
    num_subsamples             = 10000

    // manual trimming params - man_trim_mode can be 'fixed-length' or 'seq-match'; man_trim_reads can be 'r1', 'r2', or 'both' - for single-end use 'r1'
    man_trim_mode = 'fixed-length'
    man_trim_headcrop = 8
    man_trim_tailcrop = 0
    man_trim_seqs = "${projectDir}/assets/short-read/sequencing-adapters.fasta"
    man_trim_reads = 'r1'

    // select trimming tool
    trim_tool                  = "trimmomatic" // trim tool can be set to 'trimmomatic' or 'fastp'
    adapt_ref                  = "${projectDir}/assets/short-read/sequencing-adapters.fasta"

    // trimmomatic parameters
    trimmomatic_params         = "ILLUMINACLIP:${params.adapt_ref}:2:30:10 SLIDINGWINDOW:4:20 MINLEN:50"

    // seqtk length trimming parameters
    // seqtk_min_length           = 50

    // fastp QC parameters
    fastp_params               = ""
    adapter_auto_detect        = false

    // minimap2 params
    minimap2_meta = 'all-genomes'
    // the reference file can be a minimap2 index file ending in '.mmi' or it can be a fasta file
    minimap2_genome_reference = '/scicomp/groups-pure/WDPB/EMEL/Projects/Long_Read_Analysis_RUSHER/data/minimap2/index/short-read/super-genome-refseq-complete-only.mmi'
    minimap2_mismatch_penalty = 8
    include_primary_seq = true
    include_secondary_seq = false

    // Taxonomy parameters
    // if running for the first time use the helper script bin/fetch_taxonomy.sh prior to running this workflow
    seqid2taxid_map = "assets/taxonomy/tax_map.db"
    ncbi_taxonomy_names = "${projectDir}/assets/taxonomy/names.dmp"
    local_nodes_db = "${projectDir}/assets/taxonomy/parent_child_nodes.db"
    ncbi_taxonomy_nodes = "${projectDir}/assets/taxonomy/nodes.dmp"
    // designate tax IDs you want to filter for in this file
    my_tax_ids = "${projectDir}/assets/short-read/tax_ids_vspv2.txt"
	ref_fasta = "/scicomp/groups-pure/WDPB/EMEL/Projects/Long_Read_Analysis_RUSHER/data/reference/super_genome_refseq_complete_only.fna"

    // alignment classification parameters
    mapping_quality = 0

    // BLAST DB parameters
    blast_tax_db = "/scicomp/groups-pure/WDPB/EMEL/Projects/Long_Read_Analysis_RUSHER/data/blast/taxonomy"
    blast_db = "/scicomp/groups-pure/WDPB/EMEL/Projects/Long_Read_Analysis_RUSHER/data/blast/arch-bact-fung-hum-amoeba_refseq/arch-bact-fung-hum-amoeba_refseq"

    //BLAST alignment params
    blast_evalue = "1e-10"
    blast_perc_identity = "99"
    blast_target_seqs = "1"

}

/////////////////////////////////////////////////////////////

if (params.include_secondary_seq) {

    params {

        minimap2_args = "--sr -k21 -w11 --frag=yes -A2 -B${params.minimap2_mismatch_penalty} -O12,32 -E2,1 -r100 -p.5 -N20 -f1000,5000 -n2 -m25 -s40 -g100 -2K50m --heap-sort=yes --secondary-seq"

    }

} else {

    params {

        minimap2_args = "--sr -k21 -w11 --frag=yes -A2 -B${params.minimap2_mismatch_penalty} -O12,32 -E2,1 -r100 -p.5 -N20 -f1000,5000 -n2 -m25 -s40 -g100 -2K50m --heap-sort=yes"

    }

}

// Load modules.config for DSL2 module specific options
includeConfig 'modules/modules_short_read.config'
includeConfig 'modules/modules_shared.config'
