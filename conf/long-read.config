/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Meta-ONT Nextflow custom config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    
    // Input and output options
    input                      = 'assets/long-read/samplesheets/New-Mexico/2025-03_ATL-gene/samplesheet_ATL-gene_01_2910C_barcode15.csv'
    outdir                     = 'results/test/long-read'

    //DO NOT CHANGE
    workflow = "long-read"

    //enable memory saver mode for local runtime environments
    memory_saver = false


    // Designate which processes the workflow will execute
    skip_subsample                    = false
    skip_trimming                     = false
    skip_porechop                     = true   //should always be skipped unless reads have not been trimmed by dorado
    skip_cutadapt                     = true
    skip_blast_unmapped               = true

    // filters for classified reads that align with reference genomes corresponding to tax IDs specified in the my_tax_ids file
    skip_filter_alignment_by_id       = true

    // designate tax IDs you want to filter for in this file
    my_tax_ids = ""

    // include all child nodes of your designated tax IDs
    include_children = true

    // BBmap subsampling params
    num_subsamples                    = 50000

    // porechop trimming is skipped by default - software is no longer maintained - recommend using adapter trimming function built into dorado

    // set read quality minimum threshold
    chopper_q                  = 10
    chopper_min_len            = 1700
    chopper_max_len            = 2500

    // set cutadapt params
    cutadapt_adapter_fasta = "${projectDir}/assets/long-read/adapters/ATL-gene-adapters_cutadapt.fasta"

    // minimap2 params
    minimap2_meta = 'all-genomes'
    // the reference file can be a minimap2 index file ending in '.mmi' or it can be a fasta file
    minimap2_genome_reference = '/scicomp/groups-pure/WDPB/EMEL/Projects/Long_Read_Analysis_RUSHER/data/minimap2/index/short-read/super-genome-refseq-with-vspv2.mmi'
    minimap2_mismatch_penalty = 4
    include_primary_seq = true
    include_secondary_seq = false

    // Taxonomy parameters
    // if running for the first time use the helper script bin/fetch_taxonomy.sh prior to running this workflow
    seqid2taxid_map = "assets/taxonomy/tax_map.db"
    ncbi_taxonomy_names = "${projectDir}/assets/taxonomy/names.dmp"
    local_nodes_db = "${projectDir}/assets/taxonomy/parent_child_nodes.db"
    ncbi_taxonomy_nodes = "${projectDir}/assets/taxonomy/nodes.dmp"
    // designate tax IDs you want to filter for in this file
    my_tax_ids = "${projectDir}/assets/short-read/tax_ids_vspv2.txt"
	ref_fasta = /scicomp/groups-pure/WDPB/EMEL/Projects/Long_Read_Analysis_RUSHER/data/reference/super_genome_refseq.fna

    // alignment classification parameters
    mapping_quality = 0

    // BLAST DB parameters
    blast_tax_db = "/scicomp/groups-pure/WDPB/EMEL/Projects/Long_Read_Analysis_RUSHER/data/blast/taxonomy"
    blast_db = "/scicomp/groups-pure/WDPB/EMEL/Projects/Long_Read_Analysis_RUSHER/data/blast/arch-bact-fung-hum-amoeba_refseq/arch-bact-fung-hum-amoeba_refseq"

    //BLAST alignment params
    blast_evalue = "1e-10"
    blast_perc_identity = "95"
    blast_target_seqs = "1"

}

/////////////////////////////////////////////////////////////
// formats quality score parameter in chopper
params {
    chopper_args = "--quality ${params.chopper_q} --minlength ${params.chopper_min_len} --maxlength ${params.chopper_max_len}"
}

/////////////////////////////////////////////////////////////
params {

    minimap2_args = "-2 -B ${params.minimap2_mismatch_penalty} --secondary=yes --split-prefix=temp"

}

// Load modules.config for DSL2 module specific options
includeConfig 'modules/modules_long_read.config'
includeConfig 'modules/modules_shared.config'
